# Public build-time configuration
PUBLIC_SITE_URL=https://example.tld
PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key

# Cloudflare Pages/Functions secrets and variables
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
SMTP_HOST=smtp.example.tld
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_PORT=587
SMTP_SECURE=false
FROM_EMAIL_NAME=Your Name
FROM_EMAIL=no-reply@example.tld
TO_EMAIL=your-email@example.tld
SITE_URL=https://example.tld
