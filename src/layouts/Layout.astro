---
import '../styles/global.css';
import Header from '../components/Header';
import Footer from '../components/Footer';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { translations, isLocale, type Locale } from '../lib/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const currentLocale = isLocale(locale) ? locale : 'en-gb';
const siteUrl = (import.meta.env.PUBLIC_SITE_URL || 'https://salmanshafi.net').replace(/\/$/, '');
const pagePath = Astro.url.pathname.replace(/^\/(en-gb|bn)/, '').replace(/^\//, '');
const suffix = pagePath ? `${pagePath.replace(/\/$/, '')}/` : '';
const canonicalPath = getRelativeLocaleUrl(currentLocale, suffix);
const canonical = `${siteUrl}${canonicalPath}`;
const alternate = (target: Locale) => `${siteUrl}${getRelativeLocaleUrl(target, suffix)}`;
const t = translations[currentLocale];
---
<!doctype html>
<html lang={currentLocale === 'bn' ? 'bn' : 'en-GB'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/photo.webp" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#000000" />
    <meta name="description" content={t.description} />
    <meta property="og:title" content={t.title} />
    <meta property="og:description" content={t.description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${siteUrl}/share.webp`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t.title} />
    <meta name="twitter:description" content={t.description} />
    <meta name="twitter:image" content={`${siteUrl}/share.webp`} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en-GB" href={alternate('en-gb')} />
    <link rel="alternate" hreflang="bn" href={alternate('bn')} />
    <link rel="alternate" hreflang="x-default" href={alternate('en-gb')} />
    <title>{t.title}</title>
    <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer></script>
  </head>
  <body class="bg-black text-[#e5e5e5] min-h-screen flex flex-col selection:bg-[#EE0000] selection:text-white">
    <div class="min-h-screen flex flex-col">
      <Header locale={currentLocale} languageLabel={t.language} englishLabel={t.english} bengaliLabel={t.bengali} client:load />
      <main class="flex-grow"><slot /></main>
      <Footer client:load />
    </div>
  </body>
</html>
