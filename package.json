{
  "name": "nextjs-portfolio-system-admins",
  "version": "1.0.0",
  "private": true,
  "description": "Premium portfolio website built with Next.js 16 for System Administrators",
  "keywords": [
    "portfolio",
    "nextjs",
    "typescript",
    "tailwindcss",
    "contact-form",
    "system-admin"
  ],
  "author": "Mehedi <hello@mehedims.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/asma019/Next.js-Portfolio-for-System-Admins.git"
  },
  "bugs": {
    "url": "https://github.com/asma019/Next.js-Portfolio-for-System-Admins/issues"
  },
  "homepage": "https://github.com/asma019/Next.js-Portfolio-for-System-Admins",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf .next && rm -rf node_modules/.cache",
    "setup": "yarn install",
    "deploy": "yarn run build && yarn start",
    "cf-deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
	  "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.19.11",
    "framer-motion": "^12.23.26",
    "lucide-react": "^0.562.0",
    "next": "^16.2.6",
    "nodemailer": "^8.0.5",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.0.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^25.9.1",
    "@types/nodemailer": "^7.0.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.1.1",
    "postcss": "^8.5.10",
    "tailwindcss": "^4.3.0",
    "typescript": "5.8.3",
    "wrangler": "^4.94.0"
  },
  "engines": {
    "node": "24.x",
    "yarn": ">=4.0.0"
  },
  "packageManager": "yarn@4.13.0"
}
